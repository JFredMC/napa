# Copia este archivo a .env (no se versiona) para correr el backend local.
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:4310
USER_AGENT=NapaBot/0.1 (+https://github.com/JFredMC/napa)
# Tiendas VTEX que se intentan en vivo; cada una pasa además por su robots.txt.
LIVE_STORES=jumbo,olimpica,exito,carulla
CACHE_TTL_MS=600000
UPSTREAM_INTERVAL_MS=1500
CLIENT_RPM=60
# Mercado Libre: app registrada en developers.mercadolibre.com.co + refresh token (OAuth authorization_code).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
