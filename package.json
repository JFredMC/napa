{
  "name": "napa",
  "version": "0.0.0",
  "private": true,
  "description": "Ñapa: buscador y recomendador de ofertas en Colombia (puntaje, descuentos inflados, precio por unidad, historial, lista de compras con la tienda más barata y tiendas cercanas)",
  "license": "MIT",
  "author": "Jhon Maquilon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFredMC/napa.git"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
